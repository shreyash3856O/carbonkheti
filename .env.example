# ===================================
# CarbonKheti — Environment Variables
# ===================================

# --- Database (Neon Postgres) ---
# Get this from https://neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host/carbonkheti?sslmode=require"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- OTP / SMS Adapter ---
# Set to "stub" in dev (OTP is always 123456, logged to console)
# Set to "msg91" or "twilio" in prod
SMS_PROVIDER="stub"
# MSG91 (when SMS_PROVIDER=msg91)
MSG91_AUTHKEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
# Twilio (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- File Storage Adapter ---
# Set to "local" in dev (files saved to /public/uploads)
# Set to "s3" in prod
STORAGE_PROVIDER="local"
# S3 / compatible (when STORAGE_PROVIDER=s3)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-south-1"
S3_PUBLIC_URL=""

# --- Payment Adapter ---
# ⚠️ PAYMENTS NOT LIVE IN V1 — stub only
PAYMENT_PROVIDER="stub"
# Razorpay (when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Cashfree (when PAYMENT_PROVIDER=cashfree)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# --- Satellite / MRV Adapter ---
# ⚠️ NOT CONNECTED IN V1 — stub only
SATELLITE_PROVIDER="stub"

# --- App Config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CarbonKheti"
